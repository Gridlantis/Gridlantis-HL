# Gridlantis-HL — example environment file.
# Copy to .env and fill in what you need:   cp .env.example .env
#
# Format notes (the parser is loadEnv() in server.js, not dotenv):
#   • KEY=value, split on the first "=" — later "=" stay in the value.
#   • Comments must be on their own line. A trailing "# ..." becomes part of
#     the value: PORT=3000 # main  →  PORT is literally "3000 # main".
#     That is why every comment in this file sits above its key, never beside it.
#   • One leading/trailing quote is stripped. No escapes, no multi-line values,
#     no "export" prefix, no ${VAR} expansion.
#   • An already-exported shell variable overrides the value here.
#
# Only PASSWORD is required. Every other key falls back to the default shown
# in [brackets]; leave a key out entirely to take that default.


# ─── Core ─────────────────────────────────────────────────────────────────────

# Required — dashboard login. The server exits at startup without it.
PASSWORD=change-me

# [3000]
PORT=3000

# [uploads] — relative to the repo root.
UPLOAD_DIR=uploads


# ─── Optional service keys ────────────────────────────────────────────────────
# Blank or absent means that panel/feature stays off.

UPTIMEROBOT_KEY=
# Google Calendar two-way sync (/calendar). Create a "Web application" OAuth
# client in Google Cloud with the Calendar API enabled; its redirect URI must be
# http://localhost:<PORT>/api/calendar/callback unless you set GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
# Cloud AI keys. Each can also be saved on the AI page, which wins over these.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=


# ─── Weather ──────────────────────────────────────────────────────────────────
# Where the home page shows weather for. [38.8951, -77.0364]
WEATHER_LAT=
WEATHER_LON=



# ─── Mail (IMAP) ──────────────────────────────────────────────────────────────

# Leave blank to auto-detect the host from the account address.
MAIL_IMAP_HOST=

# [993]
MAIL_IMAP_PORT=993

# [true] — only the exact string "false" disables TLS.
MAIL_IMAP_TLS=true


# ─── Local AI (Ollama-compatible) ─────────────────────────────────────────────

# [http://127.0.0.1:11434] — the AI page's default local model server.
OLLAMA_HOST=
OLLAMA_MODEL=

# [180000] — 3 min with no output.
AI_IDLE_TIMEOUT_MS=180000

# [900000] — 15 min hard cap.
AI_TIMEOUT_MS=900000

# [30m] — how long Ollama holds the model in memory.
AI_KEEP_ALIVE=30m


# ─── Text to speech ───────────────────────────────────────────────────────────

# [en-GB-SoniaNeural] — Edge voice.
TTS_VOICE=en-GB-SoniaNeural

# [en_GB-jenny_dioco-medium] — offline Piper voice.
PIPER_VOICE=en_GB-jenny_dioco-medium

# [~/.local/share/piper-voices]
PIPER_VOICE_DIR=


# ─── HomeOS vendor credentials ────────────────────────────────────────────────
# Kasa, Sonoff (Tasmota/DIY) and Gosund/Tuya-local need NO credentials — they
# are spoken directly on the LAN. Only the cloud-only vendors below need these.

WYZE_EMAIL=
WYZE_PASSWORD=

# developer-api-console.wyze.com
WYZE_API_KEY=
WYZE_KEY_ID=

# [openhl-<random>] — set a fixed value to keep it stable across restarts.
WYZE_PHONE_ID=

BLINK_EMAIL=
BLINK_PASSWORD=

# Keep stable to avoid re-2FA on every restart.
BLINK_UUID=

# From the ring-client-api CLI.
RING_REFRESH_TOKEN=

# [openhl-ring-client]
RING_HARDWARE_ID=openhl-ring-client

# iot.tuya.com — cloud fallback only.
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=

# [us]
TUYA_REGION=us


# ─── Intervals and misc ports ─────────────────────────────────────────────────

# [30000] — node up/down checks.
MONITOR_MS=30000

# [10000] — HomeOS device state refresh.
HOMEOS_POLL_MS=10000

# [3600000] — 1 h portfolio snapshot.
PORTFOLIO_SAMPLE_MS=3600000

# [1025]
JOB_SEARCH_PORT=1025

# [3999] — used by lint-pages.js.
LINT_PORT=3999


# ─── HTTPS (optional) ─────────────────────────────────────────────────────────
# PEM certificate and key. When both are set Gridlantis-HL serves HTTPS on PORT.
# Browsers only allow the VM Lab console to sync the clipboard automatically on
# HTTPS (or localhost); the desktop app syncs it either way. `tailscale serve`
# is an easier way to get HTTPS — see tools/vmlab/README.md.
TLS_CERT=
TLS_KEY=


# ─── VM Lab ───────────────────────────────────────────────────────────────────
# [vmlab] — base images, VM disks, state and logs. Relative to the repo root.
# Point it at a big disk if you plan on many or Windows VMs.
VMLAB_DIR=

# QEMU binaries. Leave blank to use vmlab/qemu (tools/vmlab/install-qemu.sh)
# or whatever is on PATH.
VMLAB_QEMU=
VMLAB_QEMU_IMG=

# Directory holding OVMF_CODE*.fd + OVMF_VARS*.fd for UEFI guests. Blank = auto.
VMLAB_OVMF_DIR=

# Extra folders VM Lab scans for bootable ISOs / disk images (colon-separated).
# VMLAB_MEDIA_DIRS=/mnt/bigdisk/isos:/srv/images

# Cuttlefish (VM Lab → Cuttlefish): the folder its host tools and images were
# fetched into, where `cvd` runs. Blank = ~/Servers/cuttlefish.
# CUTTLEFISH_DIR=

# Discord bots on other machines: comma-separated label=http://host:port bot agents
# (src/domains/discord-bots.js run there). Bots on this machine come from DISCORD_BOTS_DIR.
# DISCORD_BOT_AGENTS=botbox=http://100.64.0.3:4610

# ─── Voicemail ────────────────────────────────────────────────────────────────
# Twilio account that receives voicemail (the number's TwiML ends in <Record>).
# Gridlantis-HL polls for new recordings every minute and copies them into data/voicemail.
# Leave the SID or token blank to switch the Voicemail page off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only keep voicemail left on this number (E.164, e.g. +18335550100). Blank = any.
TWILIO_NUMBER=
