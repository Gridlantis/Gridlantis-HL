{
  "name": "openhl-server",
  "productName": "Gridlantis-HL Server",
  "version": "1.1.0",
  "description": "Runs Gridlantis-HL on this computer and shows the address to open it at.",
  "author": "Gridlantis",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Gridlantis/Gridlantis-HL",
  "desktopName": "openhl-server.desktop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.js",
    "build:linux": "node scripts/stage.js && electron-builder --linux AppImage --x64 --publish never",
    "build:win": "node scripts/stage.js && electron-builder --win nsis --x64 --publish never",
    "build:mac": "node scripts/stage.js && electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.gridlantis.openhl.server",
    "productName": "Gridlantis-HL Server",
    "copyright": "\u00a9 2026 Gridlantis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "openhl",
        "to": "openhl"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Run Gridlantis-HL on this computer",
      "executableName": "openhl-server",
      "artifactName": "OpenHL-Server-linux-x86_64.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "OpenHL-Server-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "OpenHL-Server-macos-universal.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
