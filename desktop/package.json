{
  "name": "openhl-desktop",
  "productName": "Gridlantis-HL",
  "version": "1.1.0",
  "description": "Gridlantis-HL in its own window: the dashboard, VM Lab consoles with full keyboard capture and two-way clipboard.",
  "author": "Gridlantis-HL",
  "license": "UNLICENSED",
  "homepage": "http://openhl.local:3000",
  "desktopName": "openhl.desktop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --linux --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:win-installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.openhl.desktop",
    "productName": "Gridlantis-HL",
    "copyright": "Gridlantis-HL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect/**",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "OpenHL-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Gridlantis-HL <openhl@localhost>",
      "synopsis": "Gridlantis-HL dashboard and VM Lab client",
      "executableName": "openhl",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "OpenHL-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenHL-${version}-portable.${ext}"
    }
  }
}
